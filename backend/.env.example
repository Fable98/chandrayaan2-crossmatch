# ==============================================================================
# Chandrayaan-2 Lunar Crossmatch API — Environment Configuration
# ==============================================================================
# Use this template to configure environment variables in Render's Dashboard.
# Do NOT commit actual secrets or credentials to version control.

# ------------------------------------------------------------------------------
# Server Settings (Render automatically provides PORT in production)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend domains.
# In production, replace with your deployed frontend URL(s). Defaults to '*' if unset.
ALLOWED_ORIGINS=https://your-lunar-frontend.onrender.com,http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase / PostgreSQL Database Configuration (Optional)
# ------------------------------------------------------------------------------
# Primary data is served from flat JSON manifests and image tiles.
# Configure this when connecting to Supabase PostgreSQL:
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-placeholder

# ------------------------------------------------------------------------------
# Data Paths (Optional - defaults resolve automatically to repository folders)
# ------------------------------------------------------------------------------
# DATA_DIR=/opt/render/project/src/data_preprocessing_pipeline
# PROCESSED_TRIPLETS_DIR=/opt/render/project/src/data_preprocessing_pipeline/processed_triplets
# ML_OUTPUT_DIR=/opt/render/project/src/ML_model
