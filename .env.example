# ==============================================================================
# Chandrayaan-2 Lunar Crossmatch API — Environment Configuration
# ==============================================================================
# Copy or reference this file when setting environment variables in Render.
# In Render's dashboard: Go to Service -> Environment -> Add Environment Variable.

# Server Settings (Render injects PORT automatically)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# CORS Configuration
# Set to your deployed Next.js frontend URL (comma-separated if multiple). Defaults to '*' for dev.
ALLOWED_ORIGINS=https://your-lunar-frontend.onrender.com,http://localhost:3000

# Supabase / PostgreSQL Database (Optional — flat JSON files remain primary data store)
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-placeholder

# Data Directory Paths (Optional — auto-resolved within repo if omitted)
# DATA_DIR=data_preprocessing_pipeline
# PROCESSED_TRIPLETS_DIR=data_preprocessing_pipeline/processed_triplets
# ML_OUTPUT_DIR=ML_model

# ------------------------------------------------------------------------------
# Step 12 hardening (required in production)
# ------------------------------------------------------------------------------
# REQUIRED: JWT signing secret, min 32 chars. The server refuses to issue or
# accept tokens until this is set (no default ships with the code).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-48-plus-char-random-secret
# bcrypt cost factor for password hashing (12 = OWASP recommendation).
BCRYPT_ROUNDS=12
# SlowAPI throttle for /auth/* plus lockout after N failed logins.
AUTH_RATE_LIMIT=10/minute
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Optional: move user accounts from the JSON flat file to Postgres/Supabase.
# USERS_DATABASE_URL=postgresql://user:pass@host:5432/db
# Optional: Redis for rate-limit + job backends (else memory/DB fallback).
# REDIS_URL=redis://localhost:6379/0
# Upload + retention caps.
MAX_UPLOAD_MB=20
DYNAMIC_RUNS_TTL_HOURS=24
