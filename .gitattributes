# Git LFS tracking for large binary assets
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.weights filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.cub filter=lfs diff=lfs merge=lfs -text
*.qub filter=lfs diff=lfs merge=lfs -text
# Production AI verifier bundle ships RAW in git (not LFS) so every clone can
# load it without `git lfs pull`. An unpulled LFS pointer fails joblib with a
# cryptic KeyError: 118 and silently disables the trained verifier. Later
# lines win in gitattributes, so this exempts exactly this path.
ML_model/ai_verifier_model.pkl binary -filter
# Static Next.js tiles ship RAW in git (not LFS) so plain `git clone` + Vercel
# build serves them without `git lfs pull`. Matches .gitignore architecture
# note (public/images intentionally TRACKED). Later lines win, so this
# exempts the tile tree from the *.png/*.jpg rules above.
lunar-frontend/public/images/** binary -filter
# Generated API contract must keep LF endings on every platform: the
# gen-openapi.mjs --check contract test byte-compares against LF-canonical
# generator output, and a CRLF worktree (core.autocrlf=true) otherwise fails
# the check with no schema drift at all.
lunar-frontend/src/lib/backend-types.ts text eol=lf
lunar-frontend/scripts/gen-openapi.mjs text eol=lf
